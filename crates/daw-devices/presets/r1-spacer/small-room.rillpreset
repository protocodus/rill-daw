{
  "format": 1,
  "device": "r1-spacer",
  "name": "Small Room",
  "author": "Rill",
  "category": "Reverb",
  "tags": ["drums", "guitar"],
  "description": "Tight natural space.",
  "parameters": {
    "echo.on": false,
    "reverb.type": "Room",
    "reverb.size": 20.0,
    "reverb.decay": 0.4,
    "reverb.pre_delay": 5.0,
    "reverb.damping": 50.0,
    "reverb.level": -6.0
  }
}

{
  "format": 1,
  "device": "r1-mini",
  "name": "Hollow Pluck",
  "author": "Rill",
  "category": "Pluck",
  "tags": ["poly", "band-pass", "short"],
  "description": "A pulse through the band-pass OTA filter, its envelope snapping the band down; for arpeggios.",
  "parameters": {
    "osc1.wave": "Pulse",
    "osc1.width": 30.0,
    "osc2.wave": "Pulse",
    "osc2.octave": 1,
    "osc2.detune": 4.0,
    "mix.osc1": 90.0,
    "mix.osc2": 50.0,
    "filter.model": "OTA Multimode",
    "filter.type": "Band-pass",
    "filter.cutoff": 700.0,
    "filter.resonance": 45.0,
    "filter.env": 3.0,
    "filter.keytrack": 70.0,
    "fenv.attack": 1.0,
    "fenv.decay": 220.0,
    "fenv.sustain": 0.0,
    "fenv.release": 200.0,
    "aenv.attack": 1.0,
    "aenv.decay": 450.0,
    "aenv.sustain": 0.0,
    "aenv.release": 300.0,
    "velocity.cutoff": 1.0,
    "voice.unison": 2,
    "voice.spread": 35.0,
    "voice.volume": 4.0
  }
}

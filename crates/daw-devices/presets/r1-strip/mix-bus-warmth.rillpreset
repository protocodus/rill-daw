{
  "format": 1,
  "device": "r1-strip",
  "name": "Mix Bus Warmth",
  "author": "Rill",
  "category": "Bus",
  "tags": [
    "bus",
    "mix",
    "analog"
  ],
  "description": "Console colour for a whole mix: a breath of weight and air, barely compressed.",
  "parameters": {
    "mode": "Analog",
    "low.frequency": 80.0,
    "low.gain": 0.5,
    "high.frequency": 12000.0,
    "high.gain": 1.0,
    "comp.on": true,
    "comp.threshold": -10.0,
    "comp.ratio": 1.5,
    "comp.attack": 30.0,
    "comp.release": 200.0,
    "comp.makeup": 0.5
  }
}

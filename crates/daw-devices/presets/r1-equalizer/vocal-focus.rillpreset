{
  "format": 1,
  "device": "r1-equalizer",
  "name": "Vocal Focus",
  "author": "Rill",
  "category": "Master",
  "tags": ["mid/side", "vocal", "presence"],
  "description": "Brings a centred voice forward in a finished mix: presence on the mid, a little less of it on the sides.",
  "parameters": {

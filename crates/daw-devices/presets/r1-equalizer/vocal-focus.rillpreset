    "band3.gain": 2.0,
    "band3.q": 0.9,
    "band3.placement": "Mid",
    "band2.type": "Bell",
    "band2.frequency": 2500.0,
    "band2.gain": -1.5,
    "band2.q": 0.9,
    "band2.placement": "Side"
  }
}

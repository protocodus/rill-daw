{
  "format": 1,
  "device": "r1-spacer",
  "name": "Wide Doubler",
  "author": "Rill",
  "category": "Echo",
  "tags": ["vocal", "guitar"],
  "description": "Thickening without repeats: one tap left, one 3 ms later right.",
  "parameters": {

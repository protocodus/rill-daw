{
  "format": 1,
  "device": "r1-spacer",
  "name": "Every parameter",
  "description": "Every parameter key of this version, so a removed or renamed key is caught.",
  "parameters": {
    "echo.on": false,
    "echo.type": "Analog",
    "echo.sync": false,
    "echo.time": 640.0,
    "echo.division": "1/4 T",
    "echo.feedback": 72.0,
    "echo.stereo": "Wide",
    "echo.low_cut": 310.0,
    "echo.high_cut": 4300.0,
    "echo.wobble": 35.0,
    "echo.level": -13.5,
    "reverb.on": false,
    "reverb.type": "Plate",
    "reverb.pre_delay": 85.0,
    "reverb.size": 72.0,
    "reverb.decay": 6.4,
    "reverb.damping": 65.0,
    "reverb.low_cut": 310.0,
    "reverb.high_cut": 7400.0,
    "reverb.diffusion": 55.0,
    "reverb.movement": 60.0,
    "reverb.width": 130.0,
    "reverb.level": -17.5,
    "routing": "Parallel",
    "duck": 45.0,
    "mix": 64.0,
    "output": -9.6
  }
}

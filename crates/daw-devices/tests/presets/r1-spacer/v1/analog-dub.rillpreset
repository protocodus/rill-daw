{
  "format": 1,
  "device": "r1-spacer",
  "name": "Analog Dub",
  "author": "Rill",
  "category": "Echo",
  "tags": ["dub", "drums"],
  "description": "Dark bucket-brigade feedback wash.",
  "parameters": {
    "echo.type": "Analog",
    "echo.division": "1/4 D",
    "echo.feedback": 72.0,
    "echo.high_cut": 3500.0,
    "echo.low_cut": 200.0,
    "reverb.level": -14.0,
    "reverb.decay": 1.2
  }
}

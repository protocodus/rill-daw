{
  "format": 1,
  "device": "r1-spacer",
  "name": "BBD Dub",
  "author": "Rill",
  "category": "Echo",
  "tags": ["dub", "drums"],
  "description": "Dark bucket-brigade repeats that build up and step back for the source.",
  "parameters": {
    "reverb.on": false,
    "echo.model": "BBD",
    "echo.division": "1/4 D",
    "echo.feedback": 70.0,
    "echo.color": -40.0,
    "echo.low_cut": 200.0,
    "echo.duck": 30.0
  }
}

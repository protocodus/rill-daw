{
  "format": 1,
  "device": "r1-sampler",
  "name": "Sustained Loop",
  "author": "Rill",
  "category": "Sustain",
  "tags": [
    "loop",
    "poly"
  ],
  "description": "Holds a note as long as the key by looping the middle of the recording with a long seam crossfade.",
  "parameters": {
    "loop.mode": "Forward",
    "loop.start": 30.0,
    "loop.end": 85.0,
    "loop.crossfade": 120.0,
    "aenv.attack": 5.0,
    "aenv.sustain": 100.0,
    "aenv.release": 450.0
  }
}
